@model CategoriesPage
@{
    ViewData["Title"] = "Categories";
}
<a asp-action="Events" class="btn btn-link ps-0">← Manage events</a>
<h2>Categories - @Model.Event.EventName</h2>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-card p-3">
            <table class="table align-middle mb-0">
                <thead><tr><th>Category</th><th>Distance</th><th>Price</th><th>Max</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in Model.Event.Categories)
                    {
                        <tr>
                            <td>@c.CategoryName</td>
                            <td>@c.DistanceKm.ToString("0.##") km</td>
                            <td>R@c.Price.ToString("0.00")</td>
                            <td>@c.MaxParticipants</td>
                            <td class="text-end">
                                <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Delete this category?');">
                                    <input type="hidden" name="id" value="@c.CategoryId" />
                                    <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Event.Categories.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">No categories yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="rd-card p-4">
            <h4>Add a category</h4>
            <p class="text-muted small">Distance categories (e.g. 5km, 21km) or age categories (e.g. Under 20, Masters 40+).</p>
            <form asp-action="AddCategory" method="post">
                <input type="hidden" asp-for="Form.EventId" />
                <div class="mb-2"><label asp-for="Form.CategoryName" class="form-label"></label><input asp-for="Form.CategoryName" class="form-control" placeholder="e.g. 10km Run or Under 20" /><span asp-validation-for="Form.CategoryName" class="text-danger"></span></div>
                <div class="row">
                    <div class="col-6 mb-2"><label asp-for="Form.DistanceKm" class="form-label"></label><input asp-for="Form.DistanceKm" type="number" step="0.01" class="form-control" /></div>
                    <div class="col-6 mb-2"><label asp-for="Form.Price" class="form-label"></label><input asp-for="Form.Price" type="number" step="0.01" class="form-control" /></div>
                </div>
                <div class="mb-3"><label asp-for="Form.MaxParticipants" class="form-label"></label><input asp-for="Form.MaxParticipants" type="number" class="form-control" /></div>
                <button class="btn btn-rd w-100">Add category</button>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}