@model List<EventDto>
@{
    ViewData["Title"] = "Manage Events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Manage events</h2>
    <a asp-action="CreateEvent" class="btn btn-rd">+ Create event</a>
</div>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
<div class="rd-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th></th><th>Event</th><th>Date</th><th>Type</th><th>Status</th><th class="text-end">Manage</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td style="width:76px">
                            @if (!string.IsNullOrEmpty(e.BannerUrl))
                            {
                                <img src="@e.BannerUrl" alt="banner" class="rounded" style="width:64px;height:42px;object-fit:cover" />
                            }
                        </td>
                        <td><strong>@e.EventName</strong><br /><small class="text-muted">@e.Venue?.City</small></td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.EventType</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-rd" asp-action="EditEvent" asp-route-id="@e.EventId">Edit</a>
                            <a class="btn btn-sm btn-outline-rd" asp-action="Categories" asp-route-eventId="@e.EventId">Categories</a>
                            <a class="btn btn-sm btn-outline-rd" asp-action="Enrolments" asp-route-eventId="@e.EventId">Enrolments</a>
                            <a class="btn btn-sm btn-outline-rd" asp-action="Results" asp-route-eventId="@e.EventId">Results</a>
                            <form asp-action="DeleteEvent" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                                <input type="hidden" name="id" value="@e.EventId" />
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No events yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>