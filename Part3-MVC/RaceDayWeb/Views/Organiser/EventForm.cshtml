@model EventFormVm
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Event" : "Create Event";
}
<h2>@(Model.IsEdit ? "Edit event" : "Create event")</h2>
<div class="rd-card p-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form asp-action="@(Model.IsEdit ? "EditEvent" : "CreateEvent")" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="IsEdit" />
        <div class="row">
            <div class="col-md-8 mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control" /><span asp-validation-for="EventName" class="text-danger"></span></div>
            <div class="col-md-4 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select" asp-items="@(new SelectList(new[] { "Run", "Walk", "Cycle" }, Model.EventType))"></select>
            </div>
        </div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="3" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control" /><span asp-validation-for="EventDate" class="text-danger"></span></div>
            @if (Model.IsEdit)
            {
                <div class="col-md-4 mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="@(new SelectList(new[] { "Upcoming", "Completed", "Cancelled" }, Model.Status))"></select>
                </div>
            }
        </div>
        <h5 class="mt-2">Location</h5>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="VenueName" class="form-label"></label><input asp-for="VenueName" class="form-control" /><span asp-validation-for="VenueName" class="text-danger"></span></div>
            <div class="col-md-5 mb-3"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger"></span></div>
            <div class="col-md-3 mb-3"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger"></span></div>
        </div>
        <h5>Main race</h5>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="DistanceKm" class="form-label"></label><input asp-for="DistanceKm" type="number" step="0.01" class="form-control" /><span asp-validation-for="DistanceKm" class="text-danger"></span></div>
            <div class="col-md-4 mb-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" step="0.01" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
            <div class="col-md-4 mb-3"><label asp-for="MaxParticipants" class="form-label"></label><input asp-for="MaxParticipants" type="number" class="form-control" /><span asp-validation-for="MaxParticipants" class="text-danger"></span></div>
        </div>
        <div class="mb-3">
            <label asp-for="Banner" class="form-label"></label>
            @if (!string.IsNullOrEmpty(Model.BannerUrl))
            {
                <div class="mb-2"><img src="@Model.BannerUrl" alt="Current banner" class="rounded" style="max-height:120px" /></div>
            }
            <input asp-for="Banner" type="file" accept="image/*" class="form-control" />
            <div class="form-text">Uploaded to Azure Blob Storage through the RaceDay API.</div>
        </div>
        <button class="btn btn-rd">@(Model.IsEdit ? "Save changes" : "Create event")</button>
        <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}