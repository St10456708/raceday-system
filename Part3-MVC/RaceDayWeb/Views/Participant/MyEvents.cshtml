@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My Events";
}
<h2>My events</h2>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
<div class="rd-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Event</th><th>Category</th><th>Bib</th><th>Enrolled</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId"><strong>@e.EventName</strong></a></td>
                        <td>@e.CategoryName</td>
                        <td>@e.BibNumber</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            @if (e.Status == "Confirmed")
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this enrolment?');">
                                    <input type="hidden" name="id" value="@e.EnrolmentId" />
                                    <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">You have not entered any events yet. <a asp-controller="Home" asp-action="Index">Browse events</a></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>